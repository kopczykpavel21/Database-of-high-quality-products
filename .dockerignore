# WAL/journal files — never needed in the image
**/*.db-wal
**/*.db-shm
**/*.db-journal
# Allow QualityDB/products.db as the seed file for the Fly volume
# All other .db files stay out
**/*.db
!QualityDB/products.db

# Backup folder (large DB backups)
**/backup/
backup/

# Python cache
**/__pycache__/
**/*.pyc
**/*.pyo

# macOS
.DS_Store
**/.DS_Store

# Logs & temp
*.log
/tmp/

# Virtual environments
venv/
.venv/
env/

# HuggingFace cache
**/.hf_cache/

# Git
.git/
